{
  "name": "academia",
  "productName": "Academia",
  "version": "1.0.0",
  "description": "Academia",
  "author": "Academia",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "web": "node scripts/traer-web.cjs",
    "icono": "electron scripts/icono.cjs",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "playwright-core": "1.65.1",
    "@supabase/supabase-js": "2.119.2",
    "ws": "8.23.0"
  },
  "devDependencies": {
    "electron": "45.5.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.appprueba.academia",
    "productName": "Academia",
    "directories": {
      "output": "instaladores",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "escritorio.config.json",
      "app/**/*",
      "motor/**/*",
      "automatizaciones/**/*",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "artifactName": "academia-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Academia",
      "uninstallDisplayName": "Academia",
      "language": "3082"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "identity": null
    },
    "dmg": {
      "title": "Academia"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Office"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "carcardenas20-sudo",
        "repo": "dsh-plugins",
        "releaseType": "release"
      }
    ]
  }
}
